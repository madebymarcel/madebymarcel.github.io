{
  "name": "madebymarcel-portfolio",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^24.15.0"
  },
  "scripts": {
    "start": "ng serve",
    "build": "ng build && node scripts/prepare-pages-404.mjs",
    "serve": "http-server dist/portfolio/browser -a 127.0.0.1 -p 4173 -c-1",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit --project tsconfig.app.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:unit": "ng test --watch=false",
    "test:e2e": "playwright test",
    "lighthouse": "lhci autorun"
  },
  "dependencies": {
    "@angular/common": "22.3.0",
    "@angular/compiler": "22.3.0",
    "@angular/core": "22.3.0",
    "@angular/platform-browser": "22.3.0",
    "@angular/platform-server": "22.3.0",
    "@angular/router": "22.3.0",
    "@angular/ssr": "22.3.0",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular/build": "22.3.0",
    "@angular/cli": "22.3.0",
    "@angular/compiler-cli": "22.3.0",
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@lhci/cli": "0.16.1",
    "@playwright/test": "1.65.1",
    "@types/node": "24.19.2",
    "angular-eslint": "22.8.0",
    "eslint": "10.15.0",
    "globals": "17.14.0",
    "http-server": "14.1.1",
    "jsdom": "31.0.1",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vitest": "5.1.1"
  }
}
