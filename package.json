{
  "name": "madebymarcel-portfolio",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^24.15.0"
  },
  "scripts": {
    "start": "ng serve",
    "build": "ng build && node scripts/prepare-pages-404.mjs",
    "serve": "http-server dist/portfolio/browser -a 127.0.0.1 -p 4173 -c-1",
    "lint": "eslint . && node scripts/check-design-tokens.mjs && node scripts/generate-design-scales.mjs --check",
    "design:generate": "node scripts/generate-design-scales.mjs",
    "typecheck": "tsc --noEmit --project tsconfig.app.json",
    "format": "prettier --write .",
    "format:check": "prettier --check . || (prettier src/app/features/lab/layout-preview.html && exit 1)",
    "test:unit": "node --test scripts/rex-spatial.test.mjs && ng test --watch=false",
    "test:e2e": "playwright test",
    "lighthouse": "lhci autorun",
    "experiment:canoe-polo": "node --experimental-transform-types scripts/canoe-polo-experiment.mjs",
    "experiment:biped": "node --experimental-transform-types scripts/biped-experiment.mjs"
  },
  "dependencies": {
    "@angular/common": "22.3.0",
    "@angular/compiler": "22.3.0",
    "@angular/core": "22.3.0",
    "@angular/platform-browser": "22.3.0",
    "@angular/platform-server": "22.3.0",
    "@angular/router": "22.3.0",
    "@angular/ssr": "22.3.0",
    "cannon-es": "^0.20.0",
    "planck": "1.5.1",
    "rxjs": "7.8.2",
    "tslib": "2.9.1"
  },
  "devDependencies": {
    "@angular/build": "22.3.0",
    "@angular/cli": "22.3.0",
    "@angular/compiler-cli": "22.3.0",
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@lhci/cli": "0.16.1",
    "@playwright/test": "1.65.1",
    "@types/node": "26.6.6",
    "angular-eslint": "22.8.0",
    "eslint": "10.15.0",
    "globals": "17.14.0",
    "http-server": "14.1.1",
    "jsdom": "31.0.1",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vitest": "5.1.1"
  }
}
